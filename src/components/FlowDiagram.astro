---
// Before/after diagram built in HTML: crisp at any size, works on phones
// (stacks vertically) and every label stays text that search engines read.
import type { Lang } from '../config/site';
import { t } from '../i18n/ui';

type Owner = 'code' | 'ai' | 'team' | 'user';
interface Props {
  lang: Lang;
  flow: {
    title: string;
    caption: string;
    before: { label: string; metric: string; who: string };
    after: { label: string; metric: string };
    steps: { name: string; owner: Owner; who?: string }[];
    exception: { title: string; text: string };
  };
}
const { lang, flow } = Astro.props;
const s = t(lang);
const ownerLabel = (o: Owner, who?: string) =>
  who ?? (o === 'code' ? s.ownerCode : o === 'ai' ? s.ownerAi : o === 'team' ? s.ownerTeam : s.ownerUser);
const n = flow.steps.length;
---

<figure class="diagram">
  <h2 class="diagram__title">{flow.title}</h2>

  <div class="diagram__row">
    <div class="diagram__row-head">
      <p class="diagram__row-label">{flow.before.label}</p>
      <span class="diagram__metric">{flow.before.metric}</span>
    </div>
    <ol class="diagram__steps" style={`--n:${n}`}>
      {flow.steps.map((st) => (
        <li class="diagram__step">
          <span class="diagram__name">{st.name}</span>
          <span class="owner owner--team">{flow.before.who}</span>
        </li>
      ))}
    </ol>
  </div>

  <div class="diagram__row">
    <div class="diagram__row-head">
      <p class="diagram__row-label">{flow.after.label}</p>
      <span class="diagram__metric diagram__metric--after">{flow.after.metric}</span>
    </div>
    <ol class="diagram__steps" style={`--n:${n}`}>
      {flow.steps.map((st) => (
        <li class="diagram__step">
          <span class="diagram__name">{st.name}</span>
          <span class={`owner owner--${st.owner}`}>{ownerLabel(st.owner, st.who)}</span>
        </li>
      ))}
    </ol>
    <div class="diagram__exception">
      <strong>{flow.exception.title}</strong>
      <span>{flow.exception.text}</span>
    </div>
  </div>

  <ul class="diagram__key" aria-label={s.diagramKey}>
    <li class="owner owner--code">{s.ownerCode}</li>
    <li class="owner owner--ai">{s.ownerAi}</li>
    <li class="owner owner--team">{s.ownerTeam}</li>
  </ul>
  <figcaption>{flow.caption}</figcaption>
</figure>
