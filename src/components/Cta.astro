---
import { site, type Lang } from '../config/site';
import { t } from '../i18n/ui';
import { href } from '../lib/pages';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const contact = await href('contact', lang);
---

<section class="section section--flush-top" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta">
      <div class="cta__copy">
        <h2 id="cta-title">{s.ctaTitle}</h2>
        <p>{s.ctaText}</p>
      </div>
      <div class="cta__actions">
        <a class="btn btn--accent btn--lg" href={contact}>{s.bookCheck}<Icon name="arrow" /></a>
        <span class="cta__mail">{s.ctaOr} <a href={`mailto:${site.email}`}>{site.email}</a></span>
      </div>
    </div>
  </div>
</section>
