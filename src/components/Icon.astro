---
// Small inline icon set taken from the original page.
interface Props {
  name:
    | 'arrow'
    | 'check'
    | 'decision'
    | 'orchestrator'
    | 'roles'
    | 'tag'
    | 'clock'
    | 'pulse'
    | 'shield'
    | 'quote'
    | 'caret';
  class?: string;
}
const { name, class: cls } = Astro.props;
---

{name === 'arrow' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
)}
{name === 'check' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
)}
{name === 'decision' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h6l4-5h5" /><path d="M13 17h5" /><path d="M9 12l4 5" /><path d="M16 4l3 3-3 3" /><path d="M16 14l3 3-3 3" /></svg>
)}
{name === 'orchestrator' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="4" /><path d="M12 3v3" /><path d="M12 18v3" /><path d="M3 12h3" /><path d="M18 12h3" /></svg>
)}
{name === 'roles' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5" /><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" /><path d="M16 8h5" /><path d="M16 12h5" /><path d="M18 16h3" /></svg>
)}
{name === 'tag' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12V4h8l10 10-8 8L3 12z" /><circle cx="7.5" cy="7.5" r="1.5" /></svg>
)}
{name === 'clock' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
)}
{name === 'pulse' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l2-5 4 10 2-5h6" /></svg>
)}
{name === 'shield' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-0.7-8-4.5-8-9V6l8-3z" /><path d="M8.5 12l2.5 2.5 4.5-5" /></svg>
)}
{name === 'quote' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true"><path d="M9 7H5v6h4v4H5" /><path d="M19 7h-4v6h4v4h-4" /></svg>
)}
{name === 'caret' && (
  <svg class={cls} viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" /></svg>
)}
