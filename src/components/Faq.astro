---
import type { Lang } from '../config/site';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  items: { q: string; a: string }[];
  title?: string;
}
const { lang, items, title } = Astro.props;
const s = t(lang);
---

<section class="section" aria-labelledby="faq-title">
  <div class="container faq">
    <div class="faq__head">
      <p class="eyebrow">{s.faqEyebrow}</p>
      <h2 class="h2" id="faq-title">{title ?? s.faqTitle}</h2>
    </div>
    <div class="faq__list">
      {items.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
